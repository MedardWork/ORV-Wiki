# Copy to `.env` for `docker compose up` to pick these up.
# All values have safe defaults in docker-compose.yml — override only if you
# care.

POSTGRES_DB=orv_wiki
POSTGRES_USER=orv
POSTGRES_PASSWORD=orv

# Must be at least 32 characters for HMAC-SHA256.
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_CHARS_LONG_SECRET_KEY_FOR_HMAC_SHA256
