# Templated nginx config — envsubst substitutes ${PORT}, ${API_HOST}, and
# ${API_PORT} at container start (see Dockerfile for the NGINX_ENVSUBST_FILTER
# whitelist that prevents nginx's own $variables from being mangled).
#
# Local docker-compose: defaults from Dockerfile (PORT=80, API_HOST=api,
# API_PORT=8080) match the api service name + listen port.
# Railway: set PORT (auto-injected), API_HOST=api.railway.internal,
# API_PORT=${{api.PORT}}.

server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # The SPA-ish frontend is just one HTML file; serve it at /.
    location = / {
        try_files /index.html =404;
    }

    # Proxy the REST API to the backend container.
    location /api/ {
        proxy_pass         http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # SignalR negotiate + WebSocket upgrade for /hubs/*.
    location /hubs/ {
        proxy_pass         http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # OpenAPI / Scalar (Development only) — handy for poking at the API.
    location ~ ^/(openapi|scalar) {
        proxy_pass         http://${API_HOST}:${API_PORT};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Static asset caching for everything else.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
